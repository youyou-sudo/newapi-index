{
  "name": "balance-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "build:binary": "bun scripts/build-binary.mjs",
    "start": "bun .output/server/index.mjs",
