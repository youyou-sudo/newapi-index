{
  "name": "balance-panel",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "build": "furin build --target bun && tsc --noEmit",
    "build:binary": "furin build --target bun --compile embed",
    "start": "bun .furin/build/bun/server.js",
    "typecheck": "tsc --noEmit",
    "typegen": "furin typegen",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bun scripts/verify.mjs"
  },
  "dependencies": {
    "@radix-ui/react-select": "^2.4.1",
    "@teyik0/furin": "0.8.0-alpha.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "2.0.0-beta.32",
    "exact-mirror": "1.2.6",
    "evlog": "^2.33.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg-path-properties": "^2.2.0",
    "tailwind-merge": "^3.7.0",
    "typebox": "1.3.34",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bun-plugin-tailwind": "^0.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
