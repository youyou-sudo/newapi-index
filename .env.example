# Relay-station balance API (server-only; never prefix with FURIN_PUBLIC_).
# Leave empty to render the bundled fixture (clearly labelled "示例数据").
# Example: https://relay.example.com/api/balances
BALANCE_API_URL=
# Relay-station API key. Sent by default as "Authorization: Bearer <key>".
BALANCE_API_KEY=
# Upstream request timeout in milliseconds.
BALANCE_API_TIMEOUT_MS=5000
# Server-side response cache TTL in seconds (protects the upstream API).
BALANCE_CACHE_TTL_SECONDS=30
# Bun server port (Bun loads this file automatically).
PORT=3000
# new-api console URL for the hero link (build-time FURIN_PUBLIC_ variable; public).
# Leave empty for the relative /dashboard path when the panel shares new-api's
# origin; set an absolute URL when the panel is hosted on its own domain.
# Only FURIN_PUBLIC_* variables are inlined into the browser bundle.
FURIN_PUBLIC_NEWAPI_DASHBOARD_URL=
# Upstream gateway web page (server-only; the routing stage reads its trace).
# That page signs people in with the key it prints at start-up, so the server
# signs in once and polls for the browser; nothing here reaches the bundle.
# Leave both empty to show the "not configured" notice on /routing.
GATEWAY_WEB_URL=
GATEWAY_WEB_KEY=
# Upstream gateway web request timeout in milliseconds.
GATEWAY_WEB_TIMEOUT_MS=5000
# Send real account identities to the browser for local debugging.
# Unset: off in every environment (production builds and the verification suite
# always mask); 1 / 0 override it explicitly.
REVEAL_IDENTITIES=
